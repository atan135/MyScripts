# Global
SCRIPTS_OUTPUT_DIR=./outputs
SCRIPTS_LOG_LEVEL=INFO

# Git Stats
# Separate multiple repository paths with semicolons.
GIT_STATS_REPOS=D:\Projects\project-a;D:\Projects\project-b

# Optional date range. Leave empty to scan all history.
# Format: YYYY-MM-DD
GIT_STATS_DATE_FROM=
GIT_STATS_DATE_TO=

# Optional author filter. Leave empty to include all authors.
GIT_STATS_AUTHOR=

# Output format: table / csv / json
GIT_STATS_OUTPUT_FORMAT=table

# Output file. Optional for table output; required for csv/json.
GIT_STATS_OUTPUT_FILE=./outputs/git-stats/summary.csv

# Code Lines
# Project directory to scan. Required.
CODE_LINES_PROJECT_DIR=D:\Projects\project-a

# Show files with line count greater than this value.
CODE_LINES_MIN_LINES=1000

# Optional extra directory names to exclude, separated by semicolons.
CODE_LINES_EXCLUDE_DIRS=

# Optional code extensions to scan, separated by semicolons. Leave empty for defaults.
# Example: .py;.ts;.tsx;.rs
CODE_LINES_EXTENSIONS=

# Output format: table / csv / json
CODE_LINES_OUTPUT_FORMAT=table

# Output file. Optional for table output; required for csv/json.
CODE_LINES_OUTPUT_FILE=./outputs/code-lines/large-files.csv
