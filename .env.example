# Global
SCRIPTS_OUTPUT_DIR=./outputs
SCRIPTS_LOG_LEVEL=INFO

# Git Stats
# Separate multiple repository paths with semicolons.
GIT_STATS_REPOS=D:\Projects\project-a;D:\Projects\project-b

# Optional date range. Leave empty to scan all history.
# Format: YYYY-MM-DD
GIT_STATS_DATE_FROM=
GIT_STATS_DATE_TO=

# Optional author filter. Leave empty to include all authors.
GIT_STATS_AUTHOR=

# Output format: table / csv / json
GIT_STATS_OUTPUT_FORMAT=table

# Output file. Optional for table output; required for csv/json.
GIT_STATS_OUTPUT_FILE=./outputs/git-stats/summary.csv
